rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function hasRole(role) {
      return request.auth.token.role == role || userDoc(request.auth.uid).data.role == role;
    }
    function isTeacher() { return isSignedIn() && hasRole('teacher'); }
    function isStudent() { return isSignedIn() && hasRole('student'); }
    function isParent()  { return isSignedIn() && hasRole('parent'); }
    function isSchoolUser() { return isTeacher() || isStudent() || isParent(); }

    // Users
    match /users/{uid} {
      allow read: if isTeacher() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Allow a signed-in user to read/write their own subcollections (e.g., recentMaterials, activity)
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Parent-owned children list (teachers can read; parents read their own)
    match /users/{parentUid}/students/{sid} {
      allow read: if isTeacher() || (isSignedIn() && request.auth.uid == parentUid);
      allow write: if false;
    }

    // Teachers can read student profiles from any 'students' subcollection; parents can read their own if parentUid on doc
    match /{path=**}/students/{sid} {
      allow read: if isTeacher() || (isSignedIn() && resource.data.parentUid == request.auth.uid);
      allow write: if false;
    }

    // Categories (teachers create/update; all school users read)
    match /categories/{id} {
      allow read: if isSchoolUser();
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    // Materials (teachers create/update; all school users read)
    match /materials/{id} {
      allow read: if isSchoolUser();
      allow create, update: if isTeacher();
      allow delete: if false;
    }
    match /{path=**}/materials/{id} {
      allow read: if isSchoolUser();
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    // Courses and nested materials
    match /courses/{cid} {
      allow read: if isSchoolUser();
      allow write: if false;
    }
    match /courses/{cid}/materials/{mid} {
      allow read: if isSchoolUser();
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    // Optional: tracking collections keyed by user
    match /recentMaterials/{uid}/{mid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /materialViews/{uid}/{mid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Classes
    match /classes/{id} {
      allow create: if isTeacher() && request.resource.data.teacherUid == request.auth.uid;
      allow read: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
               || (isSignedIn() && request.auth.uid in resource.data.studentIds)
               || (isSignedIn() && resource.data.viewerIds != null && request.auth.uid in resource.data.viewerIds);
      allow update, delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    // Reschedule requests
    match /rescheduleRequests/{rid} {
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds;

      allow read, update: if isTeacher()
        && exists(/databases/$(database)/documents/classes/$(resource.data.classId))
        && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherUid == request.auth.uid;

      allow delete: if false;
    }

    // Top-level students collection (allow teachers to list)
    match /students/{sid} {
      allow read: if isTeacher();
      allow update: if isTeacher();   // allow teachers to mark active: false
      allow create, delete: if false;
    }

    // Materials Categories (teachers create/update; all school users read)
    match /materialsCategories/{id} {
      allow read: if isSchoolUser();
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    match /studentFees/{sid} {
      // teachers can read/write fee status; students can read their own fee status
      allow read: if isTeacher() || (isSignedIn() && request.auth.uid == sid);
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    // Per-student monthly fee docs
    match /studentFees/{sid}/months/{ym} {
      allow read: if isTeacher() || (isSignedIn() && request.auth.uid == sid);
      allow create, update: if isTeacher();
      allow delete: if false;
    }
    match /{document=**}/months/{ym} {
      allow read: if isTeacher();
    }

    match /notifications/{id} {
      allow read, write: if isSignedIn();
    }
    match /{path=**}/notifications/{id} {
      allow read, write: if isSignedIn();
    }
  }
}